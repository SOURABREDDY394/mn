PORT=3000
PUBLIC_ORIGIN=http://localhost:3000

# Google Pay & Wallet Console > Google Wallet API > Issuer ID
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLASS_ID=mn_balance_pass_v1

# Service account must have access to the issuer. Use either a key file or
# GOOGLE_CLIENT_EMAIL + GOOGLE_PRIVATE_KEY; never commit the key.
GOOGLE_APPLICATION_CREDENTIALS=./service_account.json
# GOOGLE_CLIENT_EMAIL=wallet-service-account@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
